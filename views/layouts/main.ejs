<!DOCTYPE html>
<html class="light" lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | DatSan.vn</title>
  <meta name="description" content="DatSan.vn - Nền tảng đặt sân bóng trực tuyến hiện đại và tiện lợi." />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700;900&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: "#6a37d3",
            "primary-container": "#ae8dff",
            secondary: "#00675c",
            background: "#f4f6ff",
            surface: "#f4f6ff",
            "surface-container-low": "#ebf1ff",
            "surface-container": "#dde9ff",
            "surface-container-lowest": "#ffffff",
            "on-surface": "#0b1c30",
            "on-surface-variant": "#334155",
            "outline-variant": "#a5b4cf",
            "on-primary": "#ffffff"
          },
          fontFamily: {
            headline: ["Inter", "sans-serif"],
            body: ["Inter", "sans-serif"],
            label: ["Space Grotesk", "sans-serif"]
          },
          boxShadow: {
            "cta-glow": "0 10px 25px -5px rgba(107, 56, 212, 0.4)",
            "ambient": "0 22px 40px -24px rgba(11, 28, 48, 0.12)"
          }
        }
      }
    };
  </script>
  <style>
    .material-symbols-outlined { font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24; }
    body { font-family: Inter, sans-serif; }
    .kinetic-display { font-style: normal; font-weight: 900; letter-spacing: -0.05em; }
    .kinetic-headline { font-style: normal; font-weight: 900; letter-spacing: -0.02em; }
    .kinetic-label {
      font-family: "Space Grotesk", sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      font-size: 0.72rem;
    }
    .picker-shell {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      border-radius: 1.25rem;
      background: #ffffff;
      border: 1px solid rgba(165, 180, 207, 0.45);
      padding: 0.9rem 1rem;
      cursor: pointer;
      transition: all 220ms ease;
      box-shadow: 0 8px 22px -18px rgba(11, 28, 48, 0.35);
    }
    .picker-shell:hover {
      transform: translateY(-1px);
      border-color: rgba(106, 55, 211, 0.35);
      box-shadow: 0 16px 28px -20px rgba(106, 55, 211, 0.3);
    }
    .picker-shell:focus-within {
      border-color: rgba(106, 55, 211, 0.55);
      box-shadow: 0 0 0 4px rgba(106, 55, 211, 0.1);
    }
    .picker-shell[data-picker-shell] * {
      pointer-events: none;
    }
    .picker-shell[data-picker-shell] input,
    .picker-shell[data-picker-shell] select {
      pointer-events: auto;
    }
    .picker-meta {
      display: flex;
      flex: 1;
      min-width: 0;
      flex-direction: column;
      gap: 0.18rem;
    }
    .picker-caption {
      font-size: 0.68rem;
      line-height: 1;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #64748b;
    }
    .picker-input {
      width: 100%;
      min-width: 0;
      border: none;
      background: transparent;
      padding: 0;
      font-size: 0.95rem;
      font-weight: 600;
      color: #0b1c30;
      cursor: pointer;
    }
    .picker-input:focus {
      outline: none;
      box-shadow: none;
    }
    .picker-input::-webkit-calendar-picker-indicator {
      cursor: pointer;
      opacity: 0.85;
    }

    /* ── Unified Button System ── */
    .btn-unified {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 1rem;
      padding: 0.7rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 700;
      transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      border: none;
      text-decoration: none;
      line-height: 1.4;
    }
    .btn-unified:hover { transform: translateY(-2px); }
    .btn-unified:active { transform: translateY(0) scale(0.98); }

    .btn-primary-unified {
      background: linear-gradient(135deg, #6a37d3, #ae8dff);
      color: #ffffff;
      box-shadow: 0 8px 24px -6px rgba(106, 55, 211, 0.35);
    }
    .btn-primary-unified:hover {
      box-shadow: 0 12px 28px -4px rgba(106, 55, 211, 0.45);
    }

    .btn-secondary-unified {
      background: #ebf1ff;
      color: #0b1c30;
      box-shadow: 0 4px 12px -4px rgba(11, 28, 48, 0.08);
    }
    .btn-secondary-unified:hover {
      background: #dde9ff;
      box-shadow: 0 8px 20px -4px rgba(11, 28, 48, 0.12);
    }

    .btn-outline-unified {
      background: transparent;
      color: #6a37d3;
      border: 2px solid #c4b5fd;
    }
    .btn-outline-unified:hover {
      background: #f4f0ff;
      border-color: #ae8dff;
    }

    .btn-danger-unified {
      background: rgba(239, 68, 68, 0.08);
      color: #dc2626;
      border: 1px solid rgba(239, 68, 68, 0.2);
    }
    .btn-danger-unified:hover {
      background: rgba(239, 68, 68, 0.15);
      box-shadow: 0 4px 16px -4px rgba(239, 68, 68, 0.25);
    }

    .btn-unified.btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.75rem;
    }
    .btn-unified.btn-lg {
      padding: 1rem 2rem;
      font-size: 1rem;
    }
    .btn-unified:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }
  </style>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col">
  <header class="fixed top-4 left-0 right-0 z-50 px-4 md:px-6">
    <nav class="max-w-7xl mx-auto rounded-full bg-white/80 backdrop-blur-md shadow-ambient px-4 md:px-6 py-3 flex items-center justify-between">
      <a href="/" class="font-black tracking-tight text-lg md:text-xl text-on-surface">⚽ DatSan.vn</a>
      <div class="hidden md:flex items-center gap-7 text-sm">
        <a href="/" class="<%= typeof activeNav !== 'undefined' && activeNav === 'home' ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-primary' %> font-semibold transition-all duration-300">Trang chủ</a>
        <a href="/fields" class="<%= typeof activeNav !== 'undefined' && activeNav === 'fields' ? 'text-primary border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-primary' %> font-semibold transition-all duration-300">Sân bóng</a>
        <a href="/#about" class="text-on-surface-variant hover:text-primary font-semibold transition-all duration-300">Giới thiệu</a>
      </div>
      <div class="hidden md:flex items-center gap-3">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'admin') { %><a href="/admin/dashboard" class="text-xs font-semibold rounded-full px-4 py-2 bg-surface-container-low text-primary">Admin</a><% } %>
          <% if (currentUser.role === 'field_owner') { %><a href="/owner/dashboard" class="text-xs font-semibold rounded-full px-4 py-2 bg-surface-container-low text-primary">Chủ sân</a><% } %>
          <a href="/history" class="text-sm text-on-surface-variant hover:text-primary px-2 font-semibold transition-all duration-300">Lịch sử</a>
          <!-- Avatar Dropdown -->
          <div class="relative" id="avatar-dropdown-container">
            <button
              id="avatar-dropdown-btn"
              class="w-9 h-9 rounded-full bg-gradient-to-br from-primary to-primary-container text-white font-bold text-sm flex items-center justify-center transition-all duration-300 hover:shadow-cta-glow hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary/50 focus:ring-offset-2"
              aria-label="Menu tài khoản"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <%= currentUser.name.charAt(0).toUpperCase() %>
            </button>
            <!-- Dropdown Menu -->
            <div
              id="avatar-dropdown-menu"
              class="absolute right-0 top-full mt-3 w-56 rounded-2xl bg-white/90 backdrop-blur-xl shadow-ambient border border-outline-variant/20 overflow-hidden opacity-0 invisible translate-y-2 transition-all duration-300 z-50"
              role="menu"
            >
              <!-- User info header -->
              <div class="px-4 py-3 bg-surface-container-low/50">
                <p class="text-sm font-semibold text-on-surface truncate"><%= currentUser.name %></p>
                <p class="text-xs text-on-surface-variant truncate"><%= currentUser.email %></p>
              </div>
              <!-- Menu items -->
              <div class="py-1">
                <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-surface-container-low hover:text-primary transition-all duration-300" role="menuitem">
                  <span class="material-symbols-outlined text-lg">person</span>
                  Hồ sơ cá nhân
                </a>
                <a href="/auth/logout" class="flex items-center gap-3 px-4 py-2.5 text-sm text-on-surface-variant hover:bg-red-50 hover:text-red-600 transition-all duration-300" role="menuitem">
                  <span class="material-symbols-outlined text-lg">logout</span>
                  Đăng xuất
                </a>
              </div>
            </div>
          </div>
        <% } else { %>
          <a href="/auth/login" class="text-sm text-on-surface-variant hover:text-primary px-2">Đăng nhập</a>
          <a href="/auth/register" class="rounded-full bg-gradient-to-r from-primary to-primary-container text-white px-5 py-2.5 font-semibold transition-all duration-300 hover:-translate-y-0.5 hover:shadow-cta-glow">Đăng ký</a>
        <% } %>
      </div>
      <button id="mobile-menu-btn" class="md:hidden rounded-full p-2 text-on-surface hover:bg-surface-container-low" aria-label="Mở menu điều hướng">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </nav>
    <div id="mobile-menu" class="hidden mt-3 max-w-7xl mx-auto rounded-2xl bg-white/90 backdrop-blur-md p-4 shadow-ambient">
      <div class="flex flex-col gap-3">
        <a href="/" class="px-3 py-2 rounded-xl bg-surface-container-low text-on-surface font-medium">Trang chủ</a>
        <a href="/fields" class="px-3 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low">Sân bóng</a>
        <a href="/#about" class="px-3 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low">Giới thiệu</a>
        <a href="/#contact" class="px-3 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low">Liên hệ</a>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="/profile" class="px-3 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">person</span>
            Hồ sơ cá nhân
          </a>
          <a href="/history" class="px-3 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">history</span>
            Lịch sử đặt sân
          </a>
          <a href="/auth/logout" class="px-3 py-2 rounded-xl text-red-600 hover:bg-red-50 flex items-center gap-2">
            <span class="material-symbols-outlined text-lg">logout</span>
            Đăng xuất
          </a>
        <% } else { %>
          <a href="/auth/login" class="px-3 py-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low">Đăng nhập</a>
          <a href="/auth/register" class="px-3 py-2 rounded-xl bg-primary text-white text-center font-semibold">Đăng ký</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="pt-24 md:pt-28 flex-1">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <div class="max-w-7xl mx-auto px-6 pt-2">
        <% success.forEach(msg => { %>
          <div class="flash-msg bg-surface-container-low text-on-surface px-4 py-3 rounded-2xl mb-2 flex items-center gap-2 transition-all duration-500" role="alert">
            <span class="material-symbols-outlined text-secondary">check_circle</span>
            <span class="flex-1"><%= msg %></span>
            <button type="button" onclick="this.parentElement.style.opacity='0';setTimeout(()=>this.parentElement.remove(),300)" class="ml-auto p-1 rounded-full hover:bg-surface-container transition-colors" aria-label="Đóng thông báo">
              <span class="material-symbols-outlined text-on-surface-variant text-lg">close</span>
            </button>
          </div>
        <% }) %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <div class="max-w-7xl mx-auto px-6 pt-2">
        <% error.forEach(msg => { %>
          <div class="flash-msg bg-red-50 text-red-700 px-4 py-3 rounded-2xl mb-2 flex items-center gap-2 transition-all duration-500" role="alert">
            <span class="material-symbols-outlined text-red-500">error</span>
            <span class="flex-1"><%= msg %></span>
            <button type="button" onclick="this.parentElement.style.opacity='0';setTimeout(()=>this.parentElement.remove(),300)" class="ml-auto p-1 rounded-full hover:bg-red-100 transition-colors" aria-label="Đóng thông báo">
              <span class="material-symbols-outlined text-red-400 text-lg">close</span>
            </button>
          </div>
        <% }) %>
      </div>
    <% } %>
    <%- body %>
  </main>

  <footer id="contact" class="bg-slate-950 text-slate-300 mt-10">
    <!-- Main Footer -->
    <div class="max-w-7xl mx-auto px-6 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

        <!-- Brand -->
        <div>
          <p class="text-3xl font-black text-white mb-3">DatSan.vn</p>
          <p class="kinetic-label text-slate-500 mb-4">Nền tảng đặt sân bóng cao cấp</p>
          <p class="text-sm text-slate-400 leading-relaxed">
            Nền tảng đặt sân bóng đá trực tuyến hàng đầu Việt Nam. Trải nghiệm đặt sân thông minh, nhanh chóng và chuyên nghiệp.
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Liên kết</h4>
          <ul class="space-y-3 text-sm">
            <li><a href="/" class="hover:text-white transition-colors duration-300 flex items-center gap-2"><span class="material-symbols-outlined text-sm text-slate-500">home</span> Trang chủ</a></li>
            <li><a href="/fields" class="hover:text-white transition-colors duration-300 flex items-center gap-2"><span class="material-symbols-outlined text-sm text-slate-500">stadium</span> Danh sách sân</a></li>
            <li><a href="/#about" class="hover:text-white transition-colors duration-300 flex items-center gap-2"><span class="material-symbols-outlined text-sm text-slate-500">info</span> Giới thiệu</a></li>
            <li><a href="/#policy" class="hover:text-white transition-colors duration-300 flex items-center gap-2"><span class="material-symbols-outlined text-sm text-slate-500">gavel</span> Điều khoản</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Liên hệ</h4>
          <ul class="space-y-3 text-sm">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-primary">call</span>
              <a href="tel:0901234567" class="hover:text-white transition-colors">0901 234 567</a>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-primary">mail</span>
              <a href="mailto:support@datsan.vn" class="hover:text-white transition-colors">support@datsan.vn</a>
            </li>
            <li class="flex items-start gap-2">
              <span class="material-symbols-outlined text-sm text-primary mt-0.5">location_on</span>
              <span>Quận 1, TP. Hồ Chí Minh, Việt Nam</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-sm text-primary">schedule</span>
              <span>Hỗ trợ: 6:00 – 22:00 hàng ngày</span>
            </li>
          </ul>
        </div>

        <!-- Newsletter -->
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-widest">Nhận tin mới</h4>
          <p class="text-sm text-slate-400 mb-4">Đăng ký để nhận thông tin khuyến mãi và sân mới nhất.</p>
          <form onsubmit="event.preventDefault(); this.querySelector('button').textContent='Đã đăng ký ✓'; this.querySelector('input').disabled=true;" class="flex gap-2">
            <input type="email" placeholder="Email của bạn" required class="flex-1 rounded-full bg-slate-900 border border-slate-700 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-primary transition-colors" />
            <button type="submit" class="rounded-full bg-primary text-white px-4 py-2.5 text-sm font-semibold hover:bg-primary-container transition-all duration-300">
              <span class="material-symbols-outlined text-lg">send</span>
            </button>
          </form>
          <!-- Social Links -->
          <div class="flex gap-3 mt-6">
            <a href="#" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-primary text-slate-400 hover:text-white flex items-center justify-center transition-all duration-300" aria-label="Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="#" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-primary text-slate-400 hover:text-white flex items-center justify-center transition-all duration-300" aria-label="Instagram">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href="#" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-primary text-slate-400 hover:text-white flex items-center justify-center transition-all duration-300" aria-label="YouTube">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="#" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-primary text-slate-400 hover:text-white flex items-center justify-center transition-all duration-300" aria-label="TikTok">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
