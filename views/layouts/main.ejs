  <script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function () {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Avatar dropdown toggle
    const avatarBtn = document.getElementById('avatar-dropdown-btn');
    const avatarMenu = document.getElementById('avatar-dropdown-menu');
    if (avatarBtn && avatarMenu) {
      avatarBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const isOpen = !avatarMenu.classList.contains('invisible');
        if (isOpen) {
          // Close
          avatarMenu.classList.add('opacity-0', 'invisible', 'translate-y-2');
          avatarMenu.classList.remove('opacity-100', 'visible', 'translate-y-0');
          avatarBtn.setAttribute('aria-expanded', 'false');
        } else {
          // Open
          avatarMenu.classList.remove('opacity-0', 'invisible', 'translate-y-2');
          avatarMenu.classList.add('opacity-100', 'visible', 'translate-y-0');
          avatarBtn.setAttribute('aria-expanded', 'true');
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', function (e) {
        if (!avatarBtn.contains(e.target) && !avatarMenu.contains(e.target)) {
          avatarMenu.classList.add('opacity-0', 'invisible', 'translate-y-2');
          avatarMenu.classList.remove('opacity-100', 'visible', 'translate-y-0');
          avatarBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close dropdown on Escape key
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          avatarMenu.classList.add('opacity-0', 'invisible', 'translate-y-2');
          avatarMenu.classList.remove('opacity-100', 'visible', 'translate-y-0');
          avatarBtn.setAttribute('aria-expanded', 'false');
          avatarBtn.focus();
        }
      });
    }

    // Auto-dismiss flash messages after 8 seconds (with fade-out)
    setTimeout(function () {
      document.querySelectorAll('.flash-msg').forEach(function (el) {
        el.style.opacity = '0';
        setTimeout(function () { el.remove(); }, 500);
      });
    }, 8000);

    document.querySelectorAll('[data-picker-shell]').forEach(function (shell) {
      if (shell.dataset.pickerBound === '1') return;
      shell.dataset.pickerBound = '1';

      const input = shell.querySelector('[data-picker-input]');
      if (!input) return;

      const openPicker = function () {
        if (typeof input.showPicker === 'function') {
          try {
            input.showPicker();
            return;
          } catch (error) {
            // Fall back below when showPicker is unsupported
          }
        }
        input.focus();
        input.click();
      };

      shell.setAttribute('tabindex', shell.getAttribute('tabindex') || '0');
      shell.addEventListener('click', function (event) {
        if (event.target === input) return;
        openPicker();
      });
      shell.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openPicker();
        }
      });
    });
  </script>

