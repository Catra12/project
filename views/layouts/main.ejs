  <script>
  (function () {
    const fab = document.getElementById('chat-fab');
    const panel = document.getElementById('chat-panel');
    const closeBtn = document.getElementById('chat-close-btn');
    const iconOpen = document.getElementById('chat-icon-open');
    const iconClose = document.getElementById('chat-icon-close');
    const messagesEl = document.getElementById('chat-messages');
    const inputEl = document.getElementById('chat-input');
    const sendBtn = document.getElementById('chat-send-btn');
    const charCount = document.getElementById('chat-char-count');
    const suggestionsWrap = document.getElementById('chat-suggestions-wrap');

    let isOpen = false;
    let isSending = false;
    let welcomeShown = false;

    // ─── Open / Close ───────────────────────────────────────────
    function openChat() {
      isOpen = true;
      panel.classList.add('open');
      fab.classList.add('open');
      iconOpen.style.display = 'none';
      iconClose.style.display = 'block';
      if (!welcomeShown) { showWelcome(); welcomeShown = true; }
      setTimeout(() => { inputEl.focus(); scrollBottom(); }, 350);
    }
    function closeChat() {
      isOpen = false;
      panel.classList.remove('open');
      fab.classList.remove('open');
      iconOpen.style.display = 'block';
      iconClose.style.display = 'none';
    }
    fab.addEventListener('click', () => isOpen ? closeChat() : openChat());
    closeBtn.addEventListener('click', closeChat);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen) closeChat(); });

    // ─── Welcome ─────────────────────────────────────────────────
    function showWelcome() {
      appendBotMsg('Xin chào! 👋 Tôi là trợ lý AI của <strong>DatSan.vn</strong>. Tôi có thể giúp bạn tìm sân, đặt sân, hoặc giải đáp thắc mắc. Bạn cần hỗ trợ gì?');
    }

    // ─── Message rendering ────────────────────────────────────────
    function appendBotMsg(html) {
      const wrap = document.createElement('div');
      wrap.className = 'chat-msg bot';
      wrap.innerHTML = `<div class="chat-msg-avatar">AI</div><div class="chat-bubble">${html}</div>`;
      messagesEl.appendChild(wrap);
      scrollBottom();
    }
    function appendUserMsg(text) {
      const wrap = document.createElement('div');
      wrap.className = 'chat-msg user';
      wrap.innerHTML = `<div class="chat-bubble">${escHtml(text)}</div>`;
      messagesEl.appendChild(wrap);
      scrollBottom();
    }
    function showTyping() {
      const wrap = document.createElement('div');
      wrap.className = 'typing-wrap'; wrap.id = 'chat-typing';
      wrap.innerHTML = `<div class="chat-msg-avatar">AI</div><div class="typing-bubble"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>`;
      messagesEl.appendChild(wrap);
      scrollBottom();
      return wrap;
    }
    function scrollBottom() {
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }
    function escHtml(str) {
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ─── Send message ─────────────────────────────────────────────
    async function sendMessage(msg) {
      if (isSending || !msg.trim()) return;
      msg = msg.trim();

      suggestionsWrap.style.display = 'none';
      appendUserMsg(msg);
      inputEl.value = '';
      charCount.textContent = '0 / 500';
      autoResize();

      isSending = true;
      sendBtn.disabled = true;
      const typingEl = showTyping();

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg }),
        });
        const data = await res.json();
        typingEl.remove();
        if (data.success) {
          // Convert newlines to <br> and basic markdown **bold**
          let reply = data.reply
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')
            .replace(/\n/g,'<br>');
          appendBotMsg(reply);
        } else {
          appendBotMsg('⚠️ ' + escHtml(data.error || 'Có lỗi xảy ra, vui lòng thử lại.'));
        }
      } catch (err) {
        typingEl.remove();
        appendBotMsg('⚠️ Không thể kết nối. Vui lòng kiểm tra mạng và thử lại.');
      } finally {
        isSending = false;
        sendBtn.disabled = false;
        inputEl.focus();
      }
    }

    // ─── Input handlers ───────────────────────────────────────────
    function autoResize() {
      inputEl.style.height = 'auto';
      inputEl.style.height = Math.min(inputEl.scrollHeight, 90) + 'px';
    }
    inputEl.addEventListener('input', () => {
      autoResize();
      charCount.textContent = inputEl.value.length + ' / 500';
    });
    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage(inputEl.value);
      }
    });
    sendBtn.addEventListener('click', () => sendMessage(inputEl.value));

    // ─── Quick suggestions ────────────────────────────────────────
    document.querySelectorAll('.chat-suggestion-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!welcomeShown) { showWelcome(); welcomeShown = true; }
        sendMessage(btn.dataset.q);
      });
    });
  })();
  </script>
</body>
